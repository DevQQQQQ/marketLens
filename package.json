{
	"name": "marketlens",
	"displayName": "%displayName%",
	"description": "%description%",
	"version": "1.2.5",
	"publisher": "devqqqqq",
	"repository": {
		"type": "git",
		"url": "https://github.com/DevQQQQQ/MarketLens"
	},
	"bugs": {
		"url": "https://github.com/DevQQQQQ/MarketLens/issues"
	},
	"homepage": "https://github.com/DevQQQQQ/MarketLens",
	"license": "MIT",
	"engines": {
		"vscode": "^1.85.0"
	},
	"icon": "assets/icon.png",
	"categories": [
		"Other",
		"Visualization"
	],
	"keywords": [
		"A股",
		"港股",
		"美股",
		"股票",
		"行情看板",
		"摸鱼",
		"盯盘",
		"加密货币",
		"炒币",
		"区块链",
		"实时行情",
		"crypto",
		"stock",
		"stocks",
		"binance",
		"dex",
		"tracker",
		"finance",
		"cryptocurrency",
		"quote",
		"ticker",
		"dashboard",
		"基金",
		"ETF",
		"场内基金",
		"fund",
		"etf"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"capabilities": {
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "marketlens-container",
					"title": "%viewsContainers.title%",
					"icon": "assets/icon.svg"
				}
			]
		},
		"views": {
			"marketlens-container": [
				{
					"id": "marketlens.watchlist",
					"name": "%views.watchlist.name%",
					"icon": "assets/icon.svg"
				}
			]
		},
		"commands": [
			{
				"command": "marketlens.refresh",
				"title": "%command.refresh%",
				"icon": "$(refresh)"
			},
			{
				"command": "marketlens.refreshGroup",
				"title": "%command.refreshGroup%",
				"icon": "$(refresh)"
			},
			{
				"command": "marketlens.expandAllGroups",
				"title": "%command.expandAllGroups%",
				"icon": "$(expand-all)"
			},
			{
				"command": "marketlens.sortGroup",
				"title": "%command.sortGroup%",
				"icon": "$(list-ordered)"
			},
			{
				"command": "marketlens.toggleMask",
				"title": "%command.toggleMask%",
				"icon": "$(eye)"
			},
			{
				"command": "marketlens.toggleBossKey",
				"title": "%command.toggleBossKey%",
				"icon": "$(eye-closed)"
			},
			{
				"command": "marketlens.addItem",
				"title": "%command.addItem%",
				"icon": "$(add)"
			},
			{
				"command": "marketlens.removeItem",
				"title": "%command.removeItem%",
				"icon": "$(trash)"
			},
			{
				"command": "marketlens.toggleColorNeutral",
				"title": "%command.toggleColorNeutral%",
				"icon": "$(paintcan)"
			},
			{
				"command": "marketlens.openKeybindings",
				"title": "%command.openKeybindings%",
				"icon": "$(keyboard)"
			},
			{
				"command": "marketlens.openSettings",
				"title": "%command.openSettings%",
				"icon": "$(gear)"
			},
			{
				"command": "marketlens.restoreDefaults",
				"title": "%command.restoreDefaults%",
				"icon": "$(discard)"
			},
			{
				"command": "marketlens.clearWatchlist",
				"title": "%command.clearWatchlist%",
				"icon": "$(clear-all)"
			},
			{
				"command": "marketlens.exportSettings",
				"title": "%command.exportSettings%",
				"icon": "$(export)"
			},
			{
				"command": "marketlens.importSettings",
				"title": "%command.importSettings%",
				"icon": "$(desktop-download)"
			},
			{
				"command": "marketlens.pinToTop",
				"title": "%command.pinToTop%",
				"icon": "$(pin)"
			},
			{
				"command": "marketlens.setAlert",
				"title": "%command.setAlert%",
				"icon": "$(bell)"
			},
			{
				"command": "marketlens.showLogs",
				"title": "%command.showLogs%",
				"icon": "$(output)"
			},
			{
				"command": "marketlens.copyCode",
				"title": "%command.copyCode%",
				"icon": "$(clippy)"
			}
		],
		"keybindings": [
			{
				"command": "marketlens.toggleBossKey",
				"key": "ctrl+alt+m",
				"win": "ctrl+alt+m",
				"mac": "cmd+alt+m"
			},
			{
				"command": "marketlens.toggleBossKey",
				"key": "alt+m",
				"win": "alt+m",
				"mac": "alt+m"
			},
			{
				"command": "marketlens.toggleMask",
				"key": "ctrl+alt+k",
				"win": "ctrl+alt+k",
				"mac": "cmd+alt+k"
			},
			{
				"command": "marketlens.toggleMask",
				"key": "alt+k",
				"win": "alt+k",
				"mac": "alt+k"
			},
			{
				"command": "marketlens.toggleColorNeutral",
				"key": "ctrl+alt+l",
				"win": "ctrl+alt+l",
				"mac": "cmd+alt+l"
			},
			{
				"command": "marketlens.toggleColorNeutral",
				"key": "alt+l",
				"win": "alt+l",
				"mac": "alt+l"
			}
		],
		"menus": {
			"view/title": [
				{
					"command": "marketlens.openSettings",
					"when": "view == marketlens.watchlist",
					"group": "navigation@1"
				},
				{
					"command": "marketlens.refresh",
					"when": "view == marketlens.watchlist",
					"group": "navigation@2"
				},
				{
					"command": "marketlens.toggleBossKey",
					"when": "view == marketlens.watchlist",
					"group": "navigation@3"
				},
				{
					"command": "marketlens.toggleMask",
					"when": "view == marketlens.watchlist",
					"group": "navigation@4"
				},
				{
					"command": "marketlens.addItem",
					"when": "view == marketlens.watchlist",
					"group": "navigation@5"
				},
				{
					"command": "marketlens.expandAllGroups",
					"when": "view == marketlens.watchlist",
					"group": "navigation@6"
				}
			],
			"view/item/context": [
				{
					"command": "marketlens.sortGroup",
					"when": "view == marketlens.watchlist && viewItem == groupItem",
					"group": "inline@1"
				},
				{
					"command": "marketlens.refreshGroup",
					"when": "view == marketlens.watchlist && viewItem == groupItem",
					"group": "inline@2"
				},
				{
					"command": "marketlens.sortGroup",
					"when": "view == marketlens.watchlist && viewItem == groupItem",
					"group": "1_group@1"
				},
				{
					"command": "marketlens.refreshGroup",
					"when": "view == marketlens.watchlist && viewItem == groupItem",
					"group": "1_group@2"
				},
				{
					"command": "marketlens.setAlert",
					"when": "view == marketlens.watchlist && viewItem == stockItem",
					"group": "inline@1"
				},
				{
					"command": "marketlens.removeItem",
					"when": "view == marketlens.watchlist && viewItem == stockItem",
					"group": "inline@2"
				},
				{
					"command": "marketlens.pinToTop",
					"when": "view == marketlens.watchlist && viewItem == stockItem",
					"group": "2_manage@1"
				},
				{
					"command": "marketlens.copyCode",
					"when": "view == marketlens.watchlist && viewItem == stockItem",
					"group": "2_manage@2"
				}
			]
		},
		"configuration": {
			"title": "MarketLens",
			"properties": {
				"marketlens.autoRefresh": {
					"type": "boolean",
					"default": true,
					"order": 1,
					"description": "%configuration.autoRefresh.description%"
				},
				"marketlens.refreshInterval": {
					"type": "number",
					"default": 5000,
					"minimum": 1000,
					"maximum": 300000,
					"order": 2,
					"description": "%configuration.refreshInterval.description%"
				},
				"marketlens.maskMode": {
					"type": "boolean",
					"default": false,
					"order": 3,
					"description": "%configuration.maskMode.description%"
				},
				"marketlens.colorNeutral": {
					"type": "boolean",
					"default": false,
					"order": 4,
					"description": "%configuration.colorNeutral.description%"
				},
				"marketlens.colorScheme": {
					"type": "string",
					"enum": [
						"greenUpRedDown",
						"redUpGreenDown"
					],
					"enumDescriptions": [
						"绿涨红跌（国际/加密/美股习惯，默认）",
						"红涨绿跌（A股/国内传统金融盘面习惯）"
					],
					"default": "greenUpRedDown",
					"order": 5,
					"description": "%configuration.colorScheme.description%"
				},
				"marketlens.statusBar.enabled": {
					"type": "boolean",
					"default": true,
					"order": 6,
					"description": "%configuration.statusBar.enabled.description%"
				},
				"marketlens.autoCollapseClosedGroups": {
					"type": "boolean",
					"default": true,
					"order": 7,
					"description": "%configuration.autoCollapseClosedGroups.description%"
				},
				"marketlens.proxyPort": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535,
					"default": 10808,
					"order": 8,
					"description": "%configuration.proxyPort.description%"
				},
				"marketlens.proxyUrl": {
					"type": "string",
					"default": "http://127.0.0.1:10808",
					"order": 9,
					"description": "%configuration.proxyUrl.description%"
				},
				"marketlens.fund.enabled": {
					"type": "boolean",
					"default": true,
					"order": 10,
					"description": "%configuration.fund.enabled.description%"
				},
				"marketlens.fund.networkMode": {
					"type": "string",
					"enum": [
						"direct",
						"proxy"
					],
					"enumDescriptions": [
						"直连访问（默认，腾讯接口境内推荐直连，零延迟）",
						"强制走代理"
					],
					"default": "direct",
					"order": 11,
					"description": "%configuration.fund.networkMode.description%"
				},
				"marketlens.fund.proxyUrl": {
					"type": "string",
					"default": "http://127.0.0.1:10808",
					"order": 12,
					"description": "%configuration.fund.proxyUrl.description%"
				},
				"marketlens.fund.stopOnMarketClosed": {
