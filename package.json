					"description": "%configuration.alerts.description%"
				},
				"marketlens.alertNotificationMode": {
					"type": "string",
					"enum": [
						"notification",
						"statusBarOnly",
						"both"
					],
					"enumDescriptions": [
						"右下角轻量弹窗浮窗",
						"仅底部状态栏静默提醒",
						"右下角浮窗与状态栏同时提醒"
					],
					"default": "notification",
					"order": 71,
					"description": "%configuration.alertNotificationMode.description%"
				},
				"marketlens.alertCooldownMinutes": {
					"type": "number",
					"default": 15,
					"minimum": 1,
					"maximum": 1440,
					"order": 72,
					"description": "%configuration.alertCooldownMinutes.description%"
				}
			}
		}
	},
